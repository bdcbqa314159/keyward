# clangd config for keyward. clangd reads build/<preset>/compile_commands.json
# (symlinked to the repo root), so includes and the C++ standard resolve without
# guessing. These settings just quiet the noisy, low-value diagnostics.
CompileFlags:
  Add: [-std=c++20]           # fallback for files not in the compile database

Diagnostics:
  UnusedIncludes: None        # too noisy; revisit if we want include-hygiene nudges
  MissingIncludes: None

InlayHints:
  Enabled: No

Index:
  Background: Build
